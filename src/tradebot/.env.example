# =============================================================================
# Tradebot environment template — copy to .env and fill in values.
# .env is gitignored; .env.example is safe to commit.
# =============================================================================

TRADEBOT_STRICT_CAUSAL=1
TRADEBOT_BYBIT_TIER=NONVIP
TRADEBOT_FEE_DISCOUNT=0.0
BYBIT_API_KEY=your_key_here
BYBIT_API_SECRET=your_secret_here
TRADEBOT_METRICS_PORT=8000
TRADEBOT_LOG_LEVEL=INFO
