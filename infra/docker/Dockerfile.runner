# =============================================================================
# Dockerfile.runner — het enige image van Tradebot.
#
# Draait:
#   python -I -m tradebot.carry.service --config /etc/tradebot/u1.yaml   # het Kraken-boek 24/7
#   python -I -m tradebot.carry.u1 {status|resume|unwind} --config ...    # beheer van dat boek
#   python -I -m tradebot.data.binance_vision forward YYYY-MM   # panelen + manifesten (v8)
#   python -I -m tradebot.carry {init|step|status|unwind}       # het v8-shadowboek
#   python -I -m tradebot.systematic.restate                    # de herberekening
#
# De dienst schrijft alleen in /var/lib/tradebot (een volume): staat, logboek, backups,
# heartbeat, HALT/UNWIND. Het image zelf kan read-only draaien (infra/compose).
#
# Audit 2026-10-24 (E-2): de vorige images bouwden op Python 3.11 terwijl
# pyproject.toml >= 3.13 eist, installeerden uit de ondergrenzen in plaats van de
# lockfiles, en kopieerden `apps/`, `dvc.yaml` en `notebooks/`, die geen van drieën
# bestaan. Geen ervan kon bouwen.
#
# De package wordt EDITABLE geinstalleerd: `ROOT` in de code is de bronboom
# (`Path(__file__).parents[3]`), en de bevroren configs en artefacten staan daar.
# =============================================================================
ARG PYTHON_VERSION=3.13
FROM python:${PYTHON_VERSION}-slim-bookworm

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NUMBA_CACHE_DIR=/tmp/numba_cache \
    TZ=UTC

# build-essential: numpy 1.26.4 heeft geen wheel voor 3.13 en bouwt uit de sdist.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential tini ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash --uid 10001 tradebot

WORKDIR /opt/tradebot
COPY requirements.lock ./
RUN pip install --upgrade pip wheel && pip install -r requirements.lock

COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY conf/ ./conf/
COPY artefacts/ ./artefacts/
RUN pip install --no-deps -e . \
 && mkdir -p data state artefacts/data/forward /var/lib/tradebot \
 && chown -R tradebot:tradebot /opt/tradebot /var/lib/tradebot

USER tradebot
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-I", "-m", "tradebot.carry", "status", "--state", "/opt/tradebot/state/carry.json"]
