# infra/compose/.env.example — de geheimen van de dienst. Kopieer naar .env en vul in.
# .env staat in .gitignore: zet hem nooit in de repository. Op de server: chmod 600 .env.

# Kraken (alleen nodig met `mode: live`). Twee sets: spot (api.kraken.com) en futures
# (futures.kraken.com). Geen opnamerecht naar externe adressen; IP-beperking aan.
KRAKEN_SPOT_KEY=
KRAKEN_SPOT_SECRET=
KRAKEN_FUTURES_KEY=
KRAKEN_FUTURES_SECRET=

# Alarmen: een webhook (Slack, Mattermost; Discord met /slack achter de URL) en/of Telegram.
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Een dead man's switch (bv. healthchecks.io): de dienst doet elke ronde een GET; blijft die
# uit (server weg, container hangt), dan alarmeert die dienst van buiten.
HEARTBEAT_URL=
