# infra/compose/.env.options.example — alleen voor de options-paper-dienst. Kopieer naar
# .env.options. Geen IBKR-wachtwoord (dat leest alleen de gateway uit .env.ib) en geen
# Kraken-sleutels. .env.options staat in .gitignore. Op de server: chmod 600.

# Het paper-account (begint met DU), nodig als de login meer dan één account heeft.
# Live bestaat niet.
IB_ACCOUNT=

# Alarmen (HALT, recon-break, assignment): een webhook en/of Telegram. Leeg = alleen het log.
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Een dead man's switch (bv. healthchecks.io): de dienst doet elke ronde een GET; blijft die
# uit (server weg, container hangt, gateway uit), dan alarmeert die dienst van buiten.
HEARTBEAT_URL=
